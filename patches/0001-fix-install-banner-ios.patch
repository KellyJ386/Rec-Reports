+// =============================================================================
+// Pure install-environment classification for the PWA install banner.
+//
+// Kept dependency-free (no DOM access — callers pass in the user agent and
+// touch-point count) so it can be unit-tested in vitest's plain Node
+// environment, per the repo's testing convention.
+//
+// Why classification matters: "install" means something different per browser.
+//  - Chromium (Android/desktop) fires `beforeinstallprompt`, so a real Install
+//    button works. That path is driven by the event, not by UA sniffing —
+//    this module only needs to say "not iOS".
+//  - iOS *Safari* can install only via the manual Share → Add to Home Screen
+//    gesture, and the Share button lives in a different place on iPhone
+//    (bottom toolbar) vs iPad (top right).
+//  - iOS *non-Safari* browsers (Chrome/Firefox/Edge on iOS, AI browsers,
+//    in-app webviews) generally cannot Add to Home Screen at all — telling
+//    users to "tap the Share button below" there is a dead end. The only
+//    honest instruction is "open this in Safari".
+// =============================================================================
+
+export type InstallEnv =
+  | { os: "ios"; browser: "safari" | "other"; device: "iphone" | "ipad" }
+  | { os: "other" }
+
+// Browser tokens that identify a non-Safari iOS browser. Every third-party
+// iOS browser ships WebKit but brands its UA: Chrome=CriOS, Firefox=FxiOS,
+// Edge=EdgiOS, Opera=OPiOS/OPT, Google app=GSA, plus DuckDuckGo/Brave/Yandex
+// and newer AI browsers (Comet, Arc).
+const IOS_NON_SAFARI =
+  /crios|fxios|edgios|opios|\bopt\/|gsa\/|duckduckgo|brave|yabrowser|comet|arc\//i
+
+// In-app webviews (Facebook, Instagram, Messenger, Line, WeChat, Snapchat)
+// brand the UA and usually drop the trailing "Safari/xxx" token too — but
+// match them explicitly in case they keep it.
+const IOS_WEBVIEW =
+  /fbav|fban|fb_iab|instagram|\bline\/|micromessenger|snapchat/i
+
+export function detectInstallEnv(
+  ua: string,
+  maxTouchPoints: number,
+): InstallEnv {
+  // iPadOS 13+ reports as "Macintosh" but exposes multi-touch.
+  const isIpad =
+    /ipad/i.test(ua) || (/macintosh/i.test(ua) && maxTouchPoints > 1)
+  const isIOS = isIpad || /iphone|ipod/i.test(ua)
+  if (!isIOS) return { os: "other" }
+
+  // Real Safari keeps its "Safari/xxx" token and carries no rival branding.
+  // Webviews typically omit the Safari token entirely, so requiring it
+  // catches unbranded in-app browsers as well.
+  const isSafari =
+    /safari\//i.test(ua) && !IOS_NON_SAFARI.test(ua) && !IOS_WEBVIEW.test(ua)
+
+  return {
+    os: "ios",
+    browser: isSafari ? "safari" : "other",
+    device: isIpad ? "ipad" : "iphone",
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Dismissal cool-down. The banner used to store "1" forever on dismiss; now it
+// stores a timestamp and re-surfaces after the cool-down (installing is
+// genuinely useful, but nagging forever is not — and never asking again means
+// one accidental ✕ hides the feature permanently).
+// ---------------------------------------------------------------------------
+export const DISMISS_COOLDOWN_MS = 14 * 24 * 60 * 60 * 1000 // 14 days
+
+// `raw` is whatever localStorage holds. The legacy value "1" (pre-cool-down
+// permanent dismissal) parses as epoch-ms 1 and therefore reads as expired —
+// intentional, so everyone who dismissed the old broken banner sees the fixed
+// one exactly once more.
+export function isDismissalActive(raw: string | null, now: number): boolean {
+  if (!raw) return false
+  const dismissedAt = Number(raw)
+  if (!Number.isFinite(dismissedAt)) return false
+  return now - dismissedAt < DISMISS_COOLDOWN_MS
+}
