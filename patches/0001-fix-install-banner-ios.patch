+    expect(detectInstallEnv(UA.androidChrome, 5)).toEqual({ os: "other" })
+    expect(detectInstallEnv(UA.desktopChrome, 0)).toEqual({ os: "other" })
+  })
+})
+
+describe("isDismissalActive", () => {
+  const now = 1_750_000_000_000
+
+  it("is inactive when nothing is stored", () => {
+    expect(isDismissalActive(null, now)).toBe(false)
+    expect(isDismissalActive("", now)).toBe(false)
+  })
+
+  it("is active within the cool-down window", () => {
+    expect(isDismissalActive(String(now - 1000), now)).toBe(true)
+    expect(
+      isDismissalActive(String(now - DISMISS_COOLDOWN_MS + 1), now),
+    ).toBe(true)
+  })
+
+  it("expires after the cool-down window", () => {
+    expect(isDismissalActive(String(now - DISMISS_COOLDOWN_MS), now)).toBe(
+      false,
+    )
+  })
+
+  it("treats the legacy permanent value '1' as expired (re-surface once)", () => {
+    expect(isDismissalActive("1", now)).toBe(false)
+  })
+
+  it("ignores garbage values", () => {
+    expect(isDismissalActive("not-a-number", now)).toBe(false)
+  })
+})
